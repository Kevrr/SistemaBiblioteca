<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SistemaBiblioteca</RootNamespace>
    <AssemblyName>SistemaBiblioteca</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Formularios\FrmPrincipal.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmLibros.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmAutores.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmEditoriales.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmUsuarios.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmPrestamos.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Formularios\FrmReportes.cs"><SubType>Form</SubType></Compile>
  </ItemGroup>

</Project>
